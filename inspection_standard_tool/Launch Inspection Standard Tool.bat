powershell -NoProfile -ExecutionPolicy Bypass -Command "$root='%~dp0'; $dir=Join-Path $root '1. Weekly BOM'; $files=@(); if(Test-Path -LiteralPath $dir){$files=Get-ChildItem -LiteralPath $dir -Filter *.xlsx -File | Where-Object {$_.Name -notlike '~$*'} | Sort-Object LastWriteTimeUtc -Descending | ForEach-Object {[pscustomobject]@{path=('1. Weekly BOM/' + $_.Name); name=$_.Name; modifiedUtc=$_.LastWriteTimeUtc.ToString('o')}}}; $json=ConvertTo-Json -Compress -Depth 3 -InputObject @($files); Set-Content -Encoding UTF8 -LiteralPath (Join-Path $root 'Weekly BOM Manifest.json') -Value $json" & start "" "%ProgramFiles%\Google\Chrome\Application\chrome.exe" --user-data-dir="%TEMP%\InspectionStandardToolChrome-%RANDOM%" --allow-file-access-from-files "%~dp0Inspection Standard Tool.html"
